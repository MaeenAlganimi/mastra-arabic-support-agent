# Demo mode is the default. Leave the provider keys empty and the agent
# uses a deterministic mock model, so the chat and the test suite run offline.
SUPPORT_MODEL_MODE=mock

# Real models. Set one key and switch the mode, or leave the mode unset:
# an OpenAI key wins, then a Google key, otherwise the mock stays active.
# SUPPORT_MODEL_MODE=openai
# OPENAI_API_KEY=
# SUPPORT_MODEL_MODE=google
# GOOGLE_GENERATIVE_AI_API_KEY=

# Conversation memory. Omit DATABASE_URL to use a local LibSQL file.
# A postgres:// or postgresql:// URL (including Supabase) switches memory
# to Postgres. The sample FAQ index and tickets stay on local LibSQL.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# LIBSQL_URL=file:./data/memory.db
# FAQ_DB_URL=file:./data/faq.db
# TICKET_DB_URL=file:./data/tickets.db
